/* ── Simple Downloader · tema oscuro minimalista ───────────────────────── */

Screen {
    background: #0d1117;
}

App {
    background: #0d1117;
    color: #e6edf3;
}

/* Header: superficie, título en claro, subtítulo en gris */
Header {
    background: #161b22;
    color: #e6edf3;
    height: 1;
}
Header > .title {
    color: #e6edf3;
    text-style: bold;
}
Header > .subtitle {
    color: #8b949e;
    text-style: not bold;
}

/* Footer: acciones en morado, texto secundario en gris */
Footer {
    background: #161b22;
    color: #8b949e;
}
Footer > .footer--key {
    color: #bc8cff;
    text-style: bold;
}

/* Layout principal */
#main {
    height: 100%;
    padding: 1 2;
}

/* Input de URL: borde sutil, anillo cian al enfocar */
#url-input {
    margin-bottom: 1;
    border: tall #30363d;
    background: #161b22;
    color: #e6edf3;
    padding: 0 2;
}
#url-input:focus {
    border: tall #39c5cf;
}
#url-input .input--placeholder {
    color: #6e7681;
}

/* Lista de descargas */
#list-area {
    height: 1fr;
}
#download-list {
    background: transparent;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}
#download-list:focus > DownloadItem.-highlight {
    background: #161b22;
}
DownloadItem {
    border: none;
    border-bottom: hkey #21262d;
    margin-bottom: 1;
}
DownloadItem:hover {
    background: #161b22;
}

/* Estado vacío */
#empty-state {
    color: #6e7681;
    content-align: center middle;
    height: 100%;
}

/* Barra de resumen */
#stats-bar {
    margin-top: 1;
    height: 1;
    background: #161b22;
    color: #8b949e;
}

/* ── Modales ────────────────────────────────────────────────────────────── */

DetailsModal,
ConfirmModal,
AddDownloadModal {
    align: center middle;
    background: #0d1117 70%;
}

#add-card {
    width: 62;
    max-width: 90%;
    height: auto;
    background: #161b22;
    border: tall #30363d;
    padding: 1 2;
}
#add-title {
    text-style: bold;
    margin-bottom: 1;
}
#add-url {
    color: #6e7681;
    margin-bottom: 1;
}
.field-label {
    color: #8b949e;
    margin-top: 1;
}
#add-name,
#add-folder {
    border: tall #30363d;
    background: #0d1117;
    color: #e6edf3;
    padding: 0 1;
}
#add-name:focus,
#add-folder:focus {
    border: tall #39c5cf;
}

#details-card {
    width: 64;
    max-width: 90%;
    height: auto;
    background: #161b22;
    border: tall #30363d;
    padding: 1 2;
}
#details-title {
    text-style: bold;
    margin-bottom: 1;
}
#details-content {
    color: #e6edf3;
}

#confirm-card {
    width: 60;
    max-width: 90%;
    height: auto;
    background: #161b22;
    border: tall #30363d;
    padding: 1 2;
}
#confirm-title {
    text-style: bold;
    margin-bottom: 1;
}
#confirm-message {
    color: #e6edf3;
}

#modal-hint {
    color: #6e7681;
    margin-top: 1;
    text-align: center;
}
